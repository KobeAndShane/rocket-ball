class_name DrillBase
extends Resource
## One training objective. A drill is pure data plus a small amount of runtime
## bookkeeping, so packs can be authored by hand, generated by the editor or
## saved to user:// as JSON without touching gameplay code.

enum SuccessKind {
	DRIVE_DISTANCE,
	REACH_SPEED,
	JUMP,
	DODGE,
	BALL_TOUCH,
	BALL_HIT_STRENGTH,
	SCORE,
	ENTER_ZONE,
	WALL_DRIVE,
	CEILING_TOUCH,
	SURVIVE_SHIFT,
}

@export var id: String = ""
@export var title: String = ""
@export var description: String = ""
@export var hint: String = ""
@export var success_kind: int = SuccessKind.BALL_TOUCH
@export var target_distance: float = 12.0
@export var target_speed: float = 20.0
@export var target_time: float = 3.0
@export var time_limit: float = 60.0
@export var zone_center: Vector3 = Vector3.ZERO
@export var zone_size: Vector3 = Vector3(6.0, 6.0, 6.0)
@export var min_hit_strength: float = 3.0
@export var scoring_team: int = 1
@export var require_upside_down: bool = false

# Spawn/setup overrides. A zero gravity direction keeps the current gravity.
@export var ball_spawn: Vector3 = Vector3.ZERO
@export var ball_velocity: Vector3 = Vector3.ZERO
@export var has_ball_spawn: bool = false
@export var ball_frozen: bool = false
@export var car_spawn: Vector3 = Vector3.ZERO
@export var has_car_spawn: bool = false
@export var car_forward: Vector3 = Vector3.FORWARD
@export var gravity_dir: Vector3 = Vector3.ZERO
@export var gravity_active: bool = false
@export var gravity_interval: float = 30.0
@export var enable_phases: Array[bool] = [true, true, true, true]

var _start_pos := Vector3.ZERO
var _has_start := false
var _start_up := Vector3.UP
var _start_phase := 0
var _wall_time := 0.0
var _elapsed := 0.0
var _shifted := false
var _seeded := false


func begin(start_pos: Vector3, start_phase: int = -1, start_up: Vector3 = Vector3.UP) -> void:
	_start_pos = start_pos
	_start_up = start_up
	_start_phase = start_phase
	_has_start = true
	_wall_time = 0.0
	_elapsed = 0.0
	_shifted = false
	_seeded = true


func reset_runtime() -> void:
	_has_start = false
	_seeded = false
	_wall_time = 0.0
	_elapsed = 0.0
	_shifted = false
	_start_pos = Vector3.ZERO


## Context keys are supplied by TrainingController each physics tick.
func evaluate(ctx: Dictionary) -> bool:
	if not _seeded:
		begin(ctx.get("car_pos", Vector3.ZERO), int(ctx.get("phase", -1)), ctx.get("up", Vector3.UP))
	var delta: float = float(ctx.get("delta", 0.0))
	_elapsed += delta
	var up: Vector3 = ctx.get("up", Vector3.UP)
	var phase: int = int(ctx.get("phase", _start_phase))
	if phase != _start_phase or up.distance_to(_start_up) > 0.35:
		_shifted = true
	var car_pos: Vector3 = ctx.get("car_pos", _start_pos)
	match success_kind:
		SuccessKind.DRIVE_DISTANCE:
			return car_pos.distance_to(_start_pos) >= target_distance
		SuccessKind.REACH_SPEED:
			return float(ctx.get("car_speed", 0.0)) >= target_speed
		SuccessKind.JUMP:
			return bool(ctx.get("jumped", false))
		SuccessKind.DODGE:
			return bool(ctx.get("dodged", false))
		SuccessKind.BALL_TOUCH:
			return int(ctx.get("hit_car_id", -1)) == int(ctx.get("car_id", -2)) \
				and float(ctx.get("hit_strength", 0.0)) >= min_hit_strength
		SuccessKind.BALL_HIT_STRENGTH:
			return int(ctx.get("hit_car_id", -1)) == int(ctx.get("car_id", -2)) \
				and float(ctx.get("hit_strength", 0.0)) >= target_speed
		SuccessKind.SCORE:
			var scored: bool = int(ctx.get("scored_team", 0)) == scoring_team
			if require_upside_down:
				scored = scored and up.y <= -0.5
			return scored
		SuccessKind.ENTER_ZONE:
			var p: Vector3 = car_pos - zone_center
			return absf(p.x) <= zone_size.x * 0.5 and absf(p.y) <= zone_size.y * 0.5 and absf(p.z) <= zone_size.z * 0.5
		SuccessKind.WALL_DRIVE:
			if _is_wall_ride(ctx):
				_wall_time += delta
			return _wall_time >= target_time
		SuccessKind.CEILING_TOUCH:
			return bool(ctx.get("grounded", false)) and up.y <= -0.7
		SuccessKind.SURVIVE_SHIFT:
			return _shifted and _elapsed >= target_time
	return false


func progress(ctx: Dictionary) -> float:
	match success_kind:
		SuccessKind.DRIVE_DISTANCE:
			var dist: float = (ctx.get("car_pos", _start_pos) as Vector3).distance_to(_start_pos)
			return clampf(dist / maxf(target_distance, 0.01), 0.0, 1.0)
		SuccessKind.REACH_SPEED:
			return clampf(float(ctx.get("car_speed", 0.0)) / maxf(target_speed, 0.01), 0.0, 1.0)
		SuccessKind.WALL_DRIVE, SuccessKind.SURVIVE_SHIFT:
			return clampf(_wall_time / maxf(target_time, 0.01), 0.0, 1.0) if success_kind == SuccessKind.WALL_DRIVE else clampf(_elapsed / maxf(target_time, 0.01), 0.0, 1.0)
		SuccessKind.BALL_HIT_STRENGTH:
			return clampf(float(ctx.get("hit_strength", 0.0)) / maxf(target_speed, 0.01), 0.0, 1.0)
		_:
			return 1.0 if evaluate(ctx) else 0.0


func objective_text() -> String:
	match success_kind:
		SuccessKind.DRIVE_DISTANCE:
			return "Drive %.0f m" % target_distance
		SuccessKind.REACH_SPEED:
			return "Reach %.0f km/h" % (target_speed * 3.6)
		SuccessKind.JUMP:
			return "Jump"
		SuccessKind.DODGE:
			return "Dodge"
		SuccessKind.BALL_TOUCH:
			return "Touch the ball"
		SuccessKind.BALL_HIT_STRENGTH:
			return "Hit the ball at %.0f km/h" % (target_speed * 3.6)
		SuccessKind.SCORE:
			if require_upside_down:
				return "Score while upside down"
			return "Score in the %s goal" % ("blue" if scoring_team == 1 else "orange")
		SuccessKind.ENTER_ZONE:
			return "Reach the marked zone"
		SuccessKind.WALL_DRIVE:
			return "Drive on a wall for %.1f s" % target_time
		SuccessKind.CEILING_TOUCH:
			return "Land on the ceiling"
		SuccessKind.SURVIVE_SHIFT:
			return "Ride out the gravity shift for %.1f s" % target_time
	return title


func _is_wall_ride(ctx: Dictionary) -> bool:
	if not bool(ctx.get("grounded", false)):
		return false
	var up: Vector3 = ctx.get("up", Vector3.UP)
	return absf(up.y) < 0.45 and absf(up.x) > 0.7


func to_dict() -> Dictionary:
	return {
		"id": id,
		"title": title,
		"description": description,
		"hint": hint,
		"success_kind": success_kind,
		"target_distance": target_distance,
		"target_speed": target_speed,
		"target_time": target_time,
		"time_limit": time_limit,
		"zone_center": _vec_to_array(zone_center),
		"zone_size": _vec_to_array(zone_size),
		"min_hit_strength": min_hit_strength,
		"scoring_team": scoring_team,
		"require_upside_down": require_upside_down,
		"ball_spawn": _vec_to_array(ball_spawn),
		"ball_velocity": _vec_to_array(ball_velocity),
		"has_ball_spawn": has_ball_spawn,
		"ball_frozen": ball_frozen,
		"car_spawn": _vec_to_array(car_spawn),
		"has_car_spawn": has_car_spawn,
		"car_forward": _vec_to_array(car_forward),
		"gravity_dir": _vec_to_array(gravity_dir),
		"gravity_active": gravity_active,
		"gravity_interval": gravity_interval,
		"enable_phases": enable_phases.duplicate(),
	}


static func from_dict(data: Dictionary) -> DrillBase:
	var drill := DrillBase.new()
	drill.id = str(data.get("id", ""))
	drill.title = str(data.get("title", ""))
	drill.description = str(data.get("description", ""))
	drill.hint = str(data.get("hint", ""))
	drill.success_kind = int(data.get("success_kind", SuccessKind.BALL_TOUCH))
	drill.target_distance = float(data.get("target_distance", 12.0))
	drill.target_speed = float(data.get("target_speed", 20.0))
	drill.target_time = float(data.get("target_time", 3.0))
	drill.time_limit = float(data.get("time_limit", 60.0))
	drill.zone_center = _array_to_vec(data.get("zone_center", [0.0, 0.0, 0.0]))
	drill.zone_size = _array_to_vec(data.get("zone_size", [6.0, 6.0, 6.0]))
	drill.min_hit_strength = float(data.get("min_hit_strength", 3.0))
	drill.scoring_team = int(data.get("scoring_team", 1))
	drill.require_upside_down = bool(data.get("require_upside_down", false))
	drill.ball_spawn = _array_to_vec(data.get("ball_spawn", [0.0, 0.0, 0.0]))
	drill.ball_velocity = _array_to_vec(data.get("ball_velocity", [0.0, 0.0, 0.0]))
	drill.has_ball_spawn = bool(data.get("has_ball_spawn", false))
	drill.ball_frozen = bool(data.get("ball_frozen", false))
	drill.car_spawn = _array_to_vec(data.get("car_spawn", [0.0, 0.0, 0.0]))
	drill.has_car_spawn = bool(data.get("has_car_spawn", false))
	drill.car_forward = _array_to_vec(data.get("car_forward", [0.0, 0.0, -1.0]))
	drill.gravity_dir = _array_to_vec(data.get("gravity_dir", [0.0, 0.0, 0.0]))
	drill.gravity_active = bool(data.get("gravity_active", false))
	drill.gravity_interval = float(data.get("gravity_interval", 30.0))
	var phases: Variant = data.get("enable_phases", null)
	if phases is Array:
		var out: Array[bool] = []
		for value: Variant in phases:
			out.append(bool(value))
		while out.size() < 4:
			out.append(false)
		drill.enable_phases = out
	return drill


func duplicate_drill() -> DrillBase:
	return DrillBase.from_dict(to_dict())


static func _vec_to_array(v: Vector3) -> Array:
	return [snappedf(v.x, 0.001), snappedf(v.y, 0.001), snappedf(v.z, 0.001)]


static func _array_to_vec(value: Variant) -> Vector3:
	if value is Array and (value as Array).size() >= 3:
		return Vector3(float(value[0]), float(value[1]), float(value[2]))
	if value is Vector3:
		return value
	return Vector3.ZERO
