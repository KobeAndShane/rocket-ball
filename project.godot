; Gravity Shift - Godot 4 project
config_version=5

[application]

config/name="Gravity Shift"
config/description="Rocket League-style car soccer where gravity rotates every 30 seconds."
run/main_scene="res://ui/Main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
boot_splash/bg_color=Color(0.02, 0.03, 0.06, 1)
config/icon="res://icon.svg"

[autoload]

Events="*res://autoload/Events.gd"
Settings="*res://autoload/Settings.gd"
GravityManager="*res://autoload/GravityManager.gd"
NetManager="*res://autoload/NetManager.gd"
Meta="*res://autoload/Meta.gd"
A11y="*res://autoload/Accessibility.gd"
Audio="*res://autoload/Audio.gd"
Matchmaking="*res://matchmaking/MatchmakingService.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=120
common/physics_interpolation=true
3d/physics_engine="Jolt Physics"
3d/default_gravity=0.0
common/max_physics_steps_per_frame=16

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
occlusion_culling/use_occlusion_culling=true
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.06, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[layer_names]

3d_physics/layer_1="arena"
3d_physics/layer_2="car"
3d_physics/layer_3="ball"
3d_physics/layer_4="pad"
3d_physics/layer_5="goal"
3d_physics/layer_6="trigger"

[debug]

gdscript/warnings/untyped_declaration=1
